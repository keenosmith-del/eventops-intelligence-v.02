        0
      ],
      "parameters": {
        "jsCode": "const ZERO_COST_APPROVED=false; if(!ZERO_COST_APPROVED) throw new Error('External calls disabled by zero-cost policy'); const e=$json.body?.event_id; if(!/^EVT-(101|102|103)$/.test(e||'')) throw new Error('Event is not allowed'); return [{json:{event_id:e}}];"
      }
    },
    {
      "id": "search-registrations",
      "name": "Search registrations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages",
        "options": {
          "timeout": 20000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ 'subject:(' + $json.event_id + ')' }}"
            },
            {
              "name": "maxResults",
              "value": "20"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "ASSIGN_IN_N8N",
          "name": "Dedicated synthetic Google account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "bound-message-ids",
      "name": "Bound message IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "if($json.nextPageToken) throw new Error('Mailbox result limit exceeded'); const messages=$json.messages||[]; if(messages.length>20) throw new Error('Mailbox record limit exceeded'); return messages.length?messages.map(m=>({json:{id:m.id,has_messages:true}})):[{json:{has_messages:false}}];"
      }
    },
    {
      "id": "has-messages",
      "name": "Has messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has",
              "leftValue": "={{ $json.has_messages }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
