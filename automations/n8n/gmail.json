    {
      "id": "envelope",
      "name": "Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "function body(p){if(p.parts)return p.parts.filter(x=>x.mimeType!=='text/html').map(body).join('\\n').slice(0,20000);return p.mimeType==='text/plain'?Buffer.from(p.body?.data||'', 'base64url').toString('utf8').slice(0,20000):'';}const data=$input.all().map(i=>{const m=i.json,p=m.payload||{};return {id:m.id,subject:(p.headers||[]).find(h=>h.name.toLowerCase()==='subject')?.value||'',body:body(p)};});return [{json:{data,complete:true}}];"
      }
    },
